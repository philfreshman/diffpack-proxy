{
	"name": "diffpack-proxy",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wrangler dev --port 8787",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --deny-warnings",
		"format": "oxfmt --check",
		"test": "vitest run",
		"deploy": "wrangler deploy",
		"badge": "fallow health --format badge > .github/badges/fallow-health.svg",
		"check:badge": "fallow health --format badge | diff -u .github/badges/fallow-health.svg -",
		"fallow": "fallow",
		"fallow:audit": "fallow audit",
		"prepare": "husky"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "1.4.4",
		"@cloudflare/workers-types": "5.20261019.1",
		"fallow": "3.35.0",
		"husky": "9.1.7",
		"oxfmt": "0.74.0",
		"oxlint": "1.89.0",
		"typescript": "7.0.2",
		"vitest": "5.0.5",
		"wrangler": "4.151.1"
	}
}
