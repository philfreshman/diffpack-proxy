{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"src/**/*",
			"test/**/*",
			"*.ts",
			"package.json",
			"tsconfig.json",
			"wrangler.jsonc",
			"biome.json",
			"renovate.json"
		]
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": true
	},
	"assist": {
		"enabled": false
	}
}
